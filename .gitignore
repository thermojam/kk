# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.idea
# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Таблица заказов. Должна пережить деплой: при выкладке в новую директорию
# файл базы переносится руками.
/data/

# misc
.DS_Store
*.pem
# Корень УЦ Минцифры — публичный сертификат, а не секрет. Без него в репозитории
# на сервере не соберётся доверие шлюзу и платежи упадут с SELF_SIGNED_CERT_IN_CHAIN.
!certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorming visual companion
.superpowers/
