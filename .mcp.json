{
    "mcpServers": {
        "21st": {
            "type": "http",
            "url": "https://21st.dev/api/mcp",
            "headers": {
                "x-api-key": "${TWENTYFIRST_API_KEY}"
            }
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ],
            "env": {}
        }
    }
}
