# Yandex Metrika counter ID — обязательно для прод-сборки.
# Прод-значение задано в .env.production: 109730343.
# Локально оставить пустым — счётчик не активируется (см. lib/analytics/metrika.ts).
NEXT_PUBLIC_YM_ID=

# Yandex Webmaster site verification code (meta-tag method).
# Get from https://webmaster.yandex.ru → Settings → Confirm rights.
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Google Search Console site verification code (HTML tag method).
# Get from https://search.google.com/search-console → Settings → Ownership verification.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── Интернет-эквайринг Альфа-Банка ──────────────────────────────────────────
# Ни одна переменная ниже НЕ получает префикс NEXT_PUBLIC_: с ним Next
# подставит значение прямо в браузерный бандл.

# test — alfa.rbsuat.com, prod — payment.alfabank.ru и реальные деньги.
ALFA_ENV=test

# Логин строго с суффиксом -api. Логин -operator — для входа в личный кабинет,
# шлюз его не принимает.
ALFA_USERNAME=
ALFA_PASSWORD=

# Из него строятся returnUrl и failUrl, которые уходят банку.
# На проде — реальный домен по https, без слэша на конце.
PUBLIC_BASE_URL=http://localhost:3000
#PUBLIC_BASE_URL=https://ksenia-kamenskaya.ru

# Чек по 54-ФЗ. Включать только после того, как у оператора ОФД подключена
# онлайн-касса: иначе orderBundle уходит, а чек не пробивается.
FISCALIZATION=off

# Валюта заказа. Пусто — шлюз возьмёт валюту магазина, и это правильное
# поведение: тестовый магазин заведён на 810, продуктивные обычно на 643.
ALFA_CURRENCY=

# Токен для /api/pay/refund. Возврат не должен быть доступен по одному orderId.
REFUND_TOKEN=
